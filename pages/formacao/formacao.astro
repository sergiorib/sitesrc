---
// Página Formação — montada a partir da seção 4 (Estrutura) de .specify/specs/spec-04_formacao/spec.md
import '../spa/assets/css/scale.css';
import '../spa/assets/css/tokens.css';
import './assets/css/formacao.css';

import formacao from './data/formacao.json';
import Container from '../spa/components/elementos/Container.astro';
import PageTitle from '../spa/components/elementos/PageTitle.astro';
import Subsection from '../spa/components/elementos/Subsection.astro';
import Grid from '../spa/components/elementos/Grid.astro';
import Card from '../spa/components/elementos/Card.astro';
import Logo from '../spa/components/elementos/Logo.astro';
import Header from '../spa/components/elementos/Header.astro';
import Badge from '../spa/components/elementos/Badge.astro';
---

<div
  id="page-content"
  class="page-content-wrapper page-root page-root--petroleo formacao-page"
  data-page-id="formacao"
  data-page-title="Formação"
>
  <Container estilo="centralizado">
    <PageTitle estilo="claro">Formação</PageTitle>

    <Subsection estilo="destaque" nivel={2} titulo="Acadêmica">
      <Grid colunas={{ base: 1, 768: 2 }}>
        {formacao.academica.map((item) => (
          <Card estilo="amarelo" alinhamento="centro">
            <Logo estilo="faixa" item={item.logo} />
            <Header estilo="card" nivel={3} titulo={item.titulo} />
            <Badge estilo="pilula">{item.badge}</Badge>
          </Card>
        ))}
      </Grid>
    </Subsection>

    <Subsection estilo="destaque" nivel={2} titulo="Idiomas">
      <Grid colunas={{ base: 1, 768: 2, 1024: 3 }}>
        {formacao.idiomas.map((item) => (
          <Card estilo="amarelo" alinhamento="centro">
            <Logo estilo="faixa" item={item.logo} />
            <Header estilo="card" nivel={3} titulo={item.titulo} />
          </Card>
        ))}
      </Grid>
    </Subsection>

    <Subsection estilo="destaque" nivel={2} titulo="Treinamentos">
      <Grid colunas={{ base: 1, 768: 2, 1024: 3 }}>
        {formacao.treinamentos.map((item) => (
          <Card estilo="amarelo" alinhamento="centro">
            <Logo estilo="faixa" item={item.logo} />
            <Header estilo="card" nivel={3} titulo={item.titulo} />
            <Badge estilo="pilula">{item.badge}</Badge>
          </Card>
        ))}
      </Grid>
    </Subsection>
  </Container>
</div>
