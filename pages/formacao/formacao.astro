---
import './assets/css/formacao.css';
---

<div
  id="page-content"
  class="page-content-wrapper formacao-page"
  data-page-id="formacao"
  data-page-title="Formação"
>
  <div class="panel-container">
    <h1 class="page-title">Formação</h1>

    <!-- Seção Acadêmica -->
    <section class="section-group">
      <h2 class="section-title">Acadêmica</h2>
      <div class="cards-grid cards-grid-academic">
        
        <div class="formacao-card">
          <div class="institution-logo-container">
            <img src="/pages/formacao/assets/images/logo-estacio.png" alt="Estácio" class="institution-logo" />
          </div>
          <h3 class="course-title">Superior em Ciência de Dados</h3>
          <span class="period-badge">2024 A 2026</span>
        </div>

        <div class="formacao-card">
          <div class="institution-logo-container">
            <img src="/pages/formacao/assets/images/logo-estacio-uniradial.png" alt="Estácio Uniradial" class="institution-logo" />
          </div>
          <h3 class="course-title">Superior em Análise e Desenvolvimento de Sistemas</h3>
          <span class="period-badge">2013 A 2016</span>
        </div>

      </div>
    </section>

    <!-- Seção Idiomas -->
    <section class="section-group">
      <h2 class="section-title">Idiomas</h2>
      <div class="cards-grid cards-grid-languages">
        
        <div class="formacao-card">
          <div class="institution-logo-container">
            <img src="/pages/formacao/assets/images/logo_ingles.png" alt="Inglês" class="institution-logo" />
          </div>
          <h3 class="course-title">Inglês - Intermediário</h3>
        </div>

        <div class="formacao-card">
          <div class="institution-logo-container">
            <img src="/pages/formacao/assets/images/logo_espanhol.png" alt="Espanhol" class="institution-logo" />
          </div>
          <h3 class="course-title">Espanhol - Avançado</h3>
        </div>

      </div>
    </section>

    <!-- Seção Treinamentos -->
    <section class="section-group">
      <h2 class="section-title">Treinamentos</h2>
      <div class="cards-grid cards-grid-trainings">
        
        <div class="formacao-card">
          <div class="institution-logo-container">
            <img src="/pages/formacao/assets/images/logo_enap.png" alt="ENAP" class="institution-logo" />
          </div>
          <h3 class="course-title">Estatística Descritiva, Probabilidades e Técnicas de Amostragem</h3>
          <span class="period-badge">2024</span>
        </div>

      </div>
    </section>

  </div>
</div>
