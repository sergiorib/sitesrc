---
import '../formacao/assets/css/formacao.css';
---

<div
  id="page-content"
  class="page-content-wrapper formacao-page"
  data-page-id="formacao"
  data-page-title="Formação"
>
  <div class="panel-container">
    <h2 class="page-title">Formação</h2>

    <!-- Seção Acadêmica -->
    <section class="formacao-section">
      <h3 class="section-title">Acadêmica</h3>
      <div class="cards-wrapper">
        <div class="education-card">
          <h4 class="institution-name">Universidade Estácio de Sá</h4>
          <h5 class="course-title">Pós-Graduação em Ciência de Dados</h5>
          <span class="period-badge">2023 - 2024</span>
        </div>

        <div class="education-card">
          <h4 class="institution-name">Universidade Estácio de Sá / Uniradial</h4>
          <h5 class="course-title">Tecnólogo em Análise e Desenvolvimento de Sistemas</h5>
          <span class="period-badge">2020 - 2022</span>
        </div>
      </div>
    </section>

    <!-- Seção Idiomas -->
    <section class="formacao-section">
      <h3 class="section-title">Idiomas</h3>
      <div class="cards-wrapper">
        <div class="education-card">
          <h4 class="course-title">Inglês</h4>
          <span class="period-badge">Avançado / Fluente</span>
        </div>

        <div class="education-card">
          <h4 class="course-title">Espanhol</h4>
          <span class="period-badge">Intermediário</span>
        </div>
      </div>
    </section>

    <!-- Seção Treinamentos -->
    <section class="formacao-section">
      <h3 class="section-title">Treinamentos</h3>
      <div class="cards-wrapper">
        <div class="education-card">
          <h4 class="course-title">Python Avançado para Machine Learning</h4>
          <span class="period-badge">2024</span>
        </div>

        <div class="education-card">
          <h4 class="course-title">Arquitetura de Microsserviços e Cloud</h4>
          <span class="period-badge">2023</span>
        </div>
      </div>
    </section>
  </div>
</div>
