---
// Página Histórico — montada a partir da seção 4 (Estrutura) de .specify/specs/spec-03_historico/spec.md
import './assets/css/scale.css';
import './assets/css/tokens.css';
import '../historico/assets/css/historico.css';

import historico from '../historico/data/historico.json';
import Container from './components/elementos/Container.astro';
import PageTitle from './components/elementos/PageTitle.astro';
import VerticalList from './components/elementos/VerticalList.astro';
import Card from './components/elementos/Card.astro';
import Logo from './components/elementos/Logo.astro';
import Header from './components/elementos/Header.astro';
import TagList from './components/elementos/TagList.astro';
import Badge from './components/elementos/Badge.astro';
import Paragraph from './components/elementos/Paragraph.astro';
import Panel from './components/elementos/Panel.astro';
---

<div
  id="page-content"
  class="page-content-wrapper page-root page-root--petroleo historico-page"
  data-page-id="historico"
  data-page-title="Histórico"
>
  <Container estilo="centralizado">
    <PageTitle estilo="claro">Histórico Profissional</PageTitle>

    <VerticalList estilo="amplo">
      {historico.experiencias.map((item) => (
        <Card estilo="amarelo">
          <Logo estilo="faixa" item={item.logo} />
          <Header estilo="card" nivel={3} titulo={item.cargo} />
          <VerticalList estilo="amplo">
            <TagList>
              {item.badges.map((texto) => <Badge estilo="pilula">{texto}</Badge>)}
            </TagList>
            <Paragraph estilo="escuro">{item.descricao}</Paragraph>
            <Panel estilo="claro">
              <Header estilo="card" nivel={4} titulo="Stack tecnológica e outras habilidades utilizadas nesta experiencia" />
              <TagList>
                {item.stack.map((skill) => <Badge estilo={skill.estilo}>{skill.nome}</Badge>)}
              </TagList>
            </Panel>
          </VerticalList>
        </Card>
      ))}
    </VerticalList>
  </Container>
</div>
