---
interface Props {
  trail?: Array<{ label: string; url?: string; isCurrent?: boolean }>;
}

const { trail = [{ label: 'Sobre', isCurrent: true }] } = Astro.props;
---

<nav id="breadcrumbs" class="breadcrumbs-bar" aria-label="Navegação Hierárquica">
  <ol class="breadcrumbs-list" id="breadcrumbs-list">
    {trail.map((item, index) => (
      <li class:list={['breadcrumb-item', { current: item.isCurrent }]}>
        {item.isCurrent || !item.url ? (
          <span class="breadcrumb-current-text">{item.label}</span>
        ) : (
          <a href={item.url} class="breadcrumb-link">{item.label}</a>
        )}
        {index < trail.length - 1 && (
          <span class="breadcrumb-separator" aria-hidden="true">/</span>
        )}
      </li>
    ))}
  </ol>
</nav>
