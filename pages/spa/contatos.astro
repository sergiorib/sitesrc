---
// Página Contatos — montada a partir da seção 4 (Estrutura) de .specify/specs/spec-07_contatos/spec.md
import './assets/css/scale.css';
import './assets/css/tokens.css';
import '../contatos/assets/css/contatos.css';

import contatos from '../contatos/data/contatos.json';
import PageTitle from './components/elementos/PageTitle.astro';
import Grid from './components/elementos/Grid.astro';
import LinkCard from './components/elementos/LinkCard.astro';
---

<div
  id="page-content"
  class="page-content-wrapper page-root page-root--petroleo contatos-page"
  data-page-id="contatos"
  data-page-title="Meus Contatos"
>
  <PageTitle estilo="claro">Meus Contatos</PageTitle>

  <Grid colunas={{ base: 1, 768: 2 }}>
    {contatos.map((item) => <LinkCard estilo="ciano" item={item} />)}
  </Grid>
</div>
