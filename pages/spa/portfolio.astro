---
import '../portfolio/assets/css/portfolio.css';
import '../portfolio/assets/js/portfolio.js';
---

<div id="page-content" class="page-content-wrapper" data-page-id="portfolio" data-page-title="Portfólio">
  <main class="portfolio-wrapper">

    <!-- 2.1 Título Principal da Página -->
    <h1 class="page-title">Portfólio de Projetos</h1>

    <!-- 2.2 Painel de Filtros por Categoria -->
    <nav class="filter-panel">
      <button class="filter-pill active">Análise de dados e BI</button>
      <button class="filter-pill">Machine Learning</button>
      <button class="filter-pill">Deep Learning</button>
      <button class="filter-pill">Engenharia de Dados</button>
      <button class="filter-pill">Séries Temporais</button>
      <button class="filter-pill">Processamento de Linguagem Natural (NLP)</button>
      <button class="filter-pill">Inteligência Artificial</button>
      <button class="filter-pill">Outros Projetos</button>
    </nav>

    <!-- 3.1 Seção "Análise de dados e BI" -->
    <section class="category-section">
      <h2 class="category-title">Análise de dados e BI</h2>
      <div class="project-grid">

        <!-- Card 1 -->
        <article class="project-card">
          <div>
            <img class="card-cover" src="https://via.placeholder.com/640x360/1E333D/FFFFFF?text=Dashboard+Analytics" alt="Thumb Projeto 1">
            <h3 class="card-title">Projeto 1</h3>
            <p class="card-description">
              Atuação sólida na intersecção entre modelagem matemática rigorosa, Machine Learning e liderança técnica para tom
            </p>
