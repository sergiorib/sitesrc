            <span class="tag-pill">Análise Descritiva</span>
            <span class="tag-pill">Modelagem Dimensional</span>
            <span class="tag-pill">PowerBI</span>
            <span class="tag-pill">SQL</span>
            <span class="tag-pill">Python</span>
            <span class="tag-pill">Storytelling</span>
            <span class="tag-pill">CLA</span>
