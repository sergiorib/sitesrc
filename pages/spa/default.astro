---
// Página de fallback (404) — montada a partir da seção 4.2 (Estrutura) de .specify/specs/spec-01_spa/spec.md
import './assets/css/scale.css';
import './assets/css/tokens.css';
import './assets/css/default.css';

import Container from './components/elementos/Container.astro';
import Panel from './components/elementos/Panel.astro';
import VerticalList from './components/elementos/VerticalList.astro';
import Paragraph from './components/elementos/Paragraph.astro';
import LinkItem from './components/elementos/LinkItem.astro';

// @dados.retorno
const retorno = { titulo: '← Retornar à Página Inicial (Sobre)', url: '/spa/sobre/' };
---

<div
  id="page-content"
  class="page-content-wrapper page-root page-root--petroleo default-page"
  data-page-id="default"
  data-page-title="Página não encontrada"
>
  <Container estilo="centralizado">
    <Panel estilo="escuro" titulo="⚠️ Página Não Encontrada (404)">
      <VerticalList estilo="amplo">
        <Paragraph estilo="claro">A rota ou recurso solicitado não foi localizado na estrutura do portfólio.</Paragraph>
        <LinkItem estilo="ciano" item={retorno} />
      </VerticalList>
    </Panel>
  </Container>
</div>
