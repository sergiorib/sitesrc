---
const contacts = [
  {
    id: 'telefone',
    label: 'Telefone / WhatsApp',
    value: '(11) 98368-0639',
    detail: '',
    href: 'tel:+5511983680639',
    icon: '/pages/contatos/assets/images/phone.svg'
  },
  {
    id: 'email',
    label: 'E-mail',
    value: 'Sergio.rib@live.com',
    detail: '',
    href: 'mailto:Sergio.rib@live.com',
    icon: '/pages/contatos/assets/images/mail.svg'
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    value: 'https://www.linkedin.com/in/sergio-ribeiro-cerqueira',
    detail: 'Conecte-se comigo profissionalmente',
    href: 'https://www.linkedin.com/in/sergio-ribeiro-cerqueira',
    icon: '/pages/contatos/assets/images/linkedin.svg'
  },
  {
    id: 'github',
    label: 'GitHub',
    value: 'https://github.com/sergiorib/sergiorib',
    detail: 'Veja meus códigos e projetos',
    href: 'https://github.com/sergiorib/sergiorib',
    icon: '/pages/contatos/assets/images/github.svg'
  }
];
---

<div
  id="page-content"
  class="contacts-page"
  data-page-id="contatos"
  data-page-title="Meus Contatos"
>
  <h1>Meus Contatos</h1>

  <div class="contact-grid">
    {contacts.map(contact => (
      <a href={contact.href} class="contact-card" target={contact.href.startsWith('http') ? '_blank' : '_self'} rel={contact.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
        <div class="icon-wrap">
          <img src={contact.icon} alt="" width="23" height="23" />
        </div>
        <div class="contact-info">
          <span class="contact-label">{contact.label}</span>
          <span class="contact-value">{contact.value}</span>
          {contact.detail && <span class="contact-detail">{contact.detail}</span>}
        </div>
        <span class="contact-action">↗</span>
      </a>
    ))}
  </div>
</div>
