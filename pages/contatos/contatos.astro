---
// Página Contatos — montada a partir da seção 4 (Estrutura) de .specify/specs/spec-07_contatos/spec.md
import '../spa/assets/css/scale.css';
import '../spa/assets/css/tokens.css';
import './assets/css/contatos.css';

import contatos from './data/contatos.json';
import contatosScript from './assets/js/contatos.js?raw';
import PageTitle from '../spa/components/elementos/PageTitle.astro';
import Grid from '../spa/components/elementos/Grid.astro';
import LinkCard from '../spa/components/elementos/LinkCard.astro';
---

<div
  id="page-content"
  class="page-content-wrapper page-root page-root--petroleo contatos-page"
  data-page-id="contatos"
  data-page-title="Meus Contatos"
>
  <PageTitle estilo="claro">Meus Contatos</PageTitle>

  <Grid colunas={1}>
    {contatos.map((item) => <LinkCard estilo="ciano" copiar item={item} />)}
  </Grid>

  <script is:inline type="module" set:html={contatosScript}></script>
</div>
