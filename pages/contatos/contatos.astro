---
import './assets/css/contatos.css';
---

<div id="page-content" class="contacts-page" data-page-id="contatos" data-page-title="Meus Contatos">
  <div class="content">
    <h1 id="page-title">Meus Contatos</h1>

    <div class="heading-rule"><span>Canais de contato</span></div>

    <section class="contact-grid" aria-label="Canais de contato e links">
      <a class="contact-card" href="tel:+5511983680639" aria-label="Ligar para (11) 98368-0639">
        <span class="icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 11.19 18a19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.09 3.18 2 2 0 0 1 4.08 1h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.06 8.9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7A2 2 0 0 1 22 16.92Z"/></svg>
