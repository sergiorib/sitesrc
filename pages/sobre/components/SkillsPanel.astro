---

<section class="info-panel skills-panel">
  <div class="skills-panel-header">
    <h2 class="panel-title">Habilidades</h2>
    <details class="legend-details">
      <summary class="legend-summary">Legenda de Estrelas</summary>
      <div class="legend-content">
        <div class="legend-item"><span class="legend-stars">★☆☆☆☆</span> — Conhecimento conceitual</div>
        <div class="legend-item"><span class="legend-stars">★★☆☆☆</span> — Prática básica</div>
        <div class="legend-item"><span class="legend-stars">★★★☆☆</span> — Uso em projetos pessoais</div>
        <div class="legend-item"><span class="legend-stars">★★★★☆</span> — Uso em projetos profissionais</div>
        <div class="legend-item"><span class="legend-stars">★★★★★</span> — Domínio teórico e prático</div>
      </div>
    </details>
  </div>

  <div class="skill-division">
    <h3 class="division-title">Hard-Skills</h3>
    <div class="skills-grid hard-skills-grid">
      {hardSkillsCards.map((card) => (
        <SkillCard title={card.title} skills={card.skills} type="hard" />
      ))}
    </div>
  </div>

  <div class="skill-division">
    <h3 class="division-title">Soft-Skills</h3>
    <div class="skills-grid soft-skills-grid">
      {softSkillsCards.map((card) => (
        <SkillCard title={card.title} skills={card.skills} type="soft" />
      ))}
    </div>
  </div>
</section>
